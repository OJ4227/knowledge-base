#!/usr/bin/env bash
# Vault lint gate. Installed via: git config core.hooksPath tools/hooks
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
python_bin="$repo_root/.venv/bin/python"

if [ ! -x "$python_bin" ]; then
    echo "pre-commit: .venv not found. Set it up with:" >&2
    echo "  python3 -m venv .venv && .venv/bin/pip install -r tools/requirements-dev.txt" >&2
    exit 1
fi

"$python_bin" "$repo_root/tools/lint.py" --no-report
