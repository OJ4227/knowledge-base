# Copy to tools/.env and fill in real values. tools/.env is git-ignored — never commit it.

READWISE_TOKEN=
TAVILY_API_KEY=

# Pick ONE path for tools/triage.py and tools/evals/run_eval.py:
# (1) a direct Anthropic API key, OR
ANTHROPIC_API_KEY=
# (2) a gateway/proxy in front of the API (e.g. a corporate relay) that speaks Bearer
#     auth instead of an Anthropic key — takes priority over ANTHROPIC_API_KEY if both
#     are set. This is NOT a Claude Pro/Max subscription OAuth token — those are scoped
#     to Claude Code only and are rejected by the Messages API outside it.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
